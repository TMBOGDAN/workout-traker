<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyWorkout.MainPage">
    
    
    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout
            Grid.Row="0"
            Padding="12,8"
            HorizontalOptions="Fill"
            Spacing="12"
            BackgroundColor="Black">
            <Button
                Text="Account"
                WidthRequest="100"
                HeightRequest="40"
                FontSize="14"
                Padding="10,5" 
                BackgroundColor=""/>
            <Button
                Text="Workouts"
                WidthRequest="100"
                HeightRequest="40"
                FontSize="14"
                Padding="10,5" />
            <Button
                Text="Settings"
                WidthRequest="100"
                HeightRequest="40"
                FontSize="14"
                Padding="10,5" />
        </HorizontalStackLayout>
    </Grid>

</ContentPage>
